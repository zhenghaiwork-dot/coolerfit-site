---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import { localizedPath, type Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);
const lp = (path: string) => localizedPath(locale, path);
---

<BaseLayout
  title={`${t.common.pageNotFound} | CoolerFit`}
  description={t.common.pageNotFound}
  locale={locale}
  noIndex
  skipLocaleRedirect
>
  <div class="pt-24 md:pt-32 pb-20">
    <div class="container text-center max-w-lg mx-auto">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">404</p>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-foreground mb-4">{t.common.pageNotFound}</h1>
      <p class="text-muted-foreground mb-8 leading-relaxed">
        <span class="font-mono text-sm text-foreground" data-requested-path></span>
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button href={lp("/")}>{t.common.home}</Button>
        <Button variant="outline" href={lp("/products")}>{t.nav.products}</Button>
        <Button variant="outline" href={lp("/contact")}>{t.nav.contact}</Button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const target = document.querySelector<HTMLElement>("[data-requested-path]");
  if (target) target.textContent = window.location.pathname;
</script>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import CategorySeoContent from "@/components/CategorySeoContent.astro";
import { toProductCategory, type CategoryEntry } from "@/lib/content";
import { categoryPageH1 } from "@/lib/category-seo";
import { localizedPath, type Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";

interface Props {
  locale: Locale;
  entry: CategoryEntry;
}

const { locale, entry } = Astro.props;
const t = ui(locale);
const product = toProductCategory(entry);
const lp = (p: string) => localizedPath(locale, p);
const pageH1 = categoryPageH1(product.title);
const canonicalPath = product.canonicalSlug
  ? lp(`/products/${product.canonicalSlug}`)
  : lp(`/products/${product.slug}`);
---

<BaseLayout
  title={`${pageH1} | CoolerFit`}
  description={product.description}
  canonicalPath={canonicalPath}
  alternatePath={`/products/${product.canonicalSlug ?? product.slug}`}
  locale={locale}
>
  <div class="pt-24 md:pt-32 pb-20">
    <div class="container">
      <Breadcrumb
        class="mb-6"
        items={[
          { label: t.common.home, href: lp("/") },
          { label: t.nav.products, href: lp("/products") },
          { label: product.title },
        ]}
      />
      <h1 class="text-3xl md:text-5xl font-display font-bold text-foreground mb-4">{pageH1}</h1>
      <p class="text-muted-foreground max-w-3xl mb-10">{product.description}</p>
      <CategorySeoContent product={product} />
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_CONTACT, SITE_NAME, SITE_URL } from "@/lib/site";
import { getPageEntry } from "@/lib/content";
import { defaultLocale, localizedPath, type Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = ui(locale);
const lp = (path: string) => localizedPath(locale, path);
const page = await getPageEntry("privacy", locale);

const intro =
  page?.body?.trim() ??
  (locale === "es"
    ? `Esta política de privacidad describe cómo ${SITE_NAME} recopila y utiliza información en ${SITE_URL}.`
    : locale === "ar"
      ? `تصف سياسة الخصوصية هذه كيف تجمع ${SITE_NAME} المعلومات وتستخدمها على ${SITE_URL}.`
      : `${SITE_NAME} (${SITE_URL}) manufactures custom evaporative cooler covers. This policy explains what information we collect when you use our website, how we use it, and the choices you have.`);

const lastUpdated = locale === "es" ? "Última actualización: junio 2026" : locale === "ar" ? "آخر تحديث: يونيو 2026" : "Last updated: June 2026";
---

<BaseLayout
  title={page?.data.title ?? `${t.common.privacy} | ${SITE_NAME}`}
  description={page?.data.description ?? `How ${SITE_NAME} collects, uses, and protects information submitted through our website inquiry forms.`}
  canonicalPath={lp("/privacy")}
  alternatePath="/privacy"
  locale={locale}
>
  <div class="pt-24 md:pt-32 pb-20">
    <div class="container max-w-3xl">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-foreground mb-4">{t.common.privacy}</h1>
      <p class="text-sm text-muted-foreground mb-10">{lastUpdated}</p>

      <div class="space-y-8 text-muted-foreground leading-relaxed">
        {
          locale === "es" ? (
            <>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">Resumen</h2>
                <p>{intro}</p>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">Información que recopilamos</h2>
                <p class="mb-3">Cuando envía un formulario de cotización o contacto, podemos recopilar:</p>
                <ul class="list-disc pl-5 space-y-1 text-sm">
                  <li>Nombre, empresa, correo electrónico y teléfono</li>
                  <li>Requisitos del producto, dimensiones, cantidades y notas del proyecto que proporcione</li>
                  <li>Archivos que cargue (por ejemplo, arte de logotipo para fundas con marca)</li>
                  <li>Datos técnicos básicos como tipo de navegador y páginas visitadas (registros estándar del servidor)</li>
                </ul>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">Cómo usamos su información</h2>
                <ul class="list-disc pl-5 space-y-1 text-sm">
                  <li>Responder consultas y preparar cotizaciones</li>
                  <li>Comunicarnos sobre pedidos, muestras y producción</li>
                  <li>Mejorar nuestro sitio web y servicio al cliente</li>
                  <li>Cumplir obligaciones legales cuando aplique</li>
                </ul>
                <p class="mt-3">No vendemos su información personal a terceros.</p>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">Retención de datos</h2>
                <p>
                  Conservamos registros de consultas el tiempo necesario para atender su solicitud, mantener registros comerciales y resolver disputas. Puede solicitar que eliminemos datos de contacto no esenciales cuando la ley local lo permita.
                </p>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">Contacto</h2>
                <p>
                  Para preguntas o solicitudes relacionadas con privacidad, escriba a{" "}
                  <a href={`mailto:${SITE_CONTACT.email}`} class="text-primary hover:underline">{SITE_CONTACT.email}</a>.
                </p>
              </section>
            </>
          ) : locale === "ar" ? (
            <>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">نظرة عامة</h2>
                <p>{intro}</p>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">المعلومات التي نجمعها</h2>
                <p class="mb-3">عند إرسال نموذج عرض سعر أو اتصال، قد نجمع:</p>
                <ul class="list-disc pl-5 space-y-1 text-sm">
                  <li>الاسم والشركة والبريد الإلكتروني ورقم الهاتف</li>
                  <li>متطلبات المنتج والأبعاد والكميات وملاحظات المشروع التي تقدّمها</li>
                  <li>الملفات التي ترفعها (مثل artwork الشعار للأغطية بعلامة تجارية)</li>
                  <li>بيانات تقنية أساسية مثل نوع المتصفح والصفحات التي زُرت (سجلات خادم قياسية)</li>
                </ul>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">كيف نستخدم معلوماتك</h2>
                <ul class="list-disc pl-5 space-y-1 text-sm">
                  <li>الرد على الاستفسارات وإعداد عروض الأسعار</li>
                  <li>التواصل بشأن الطلبات والعينات والإنتاج</li>
                  <li>تحسين موقعنا وخدمة العملاء</li>
                  <li>الامتثال للالتزامات القانونية عند الاقتضاء</li>
                </ul>
                <p class="mt-3">لا نبيع معلوماتك الشخصية لأطراف ثالثة.</p>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">الاحتفاظ بالبيانات</h2>
                <p>
                  نحتفظ بسجلات الاستفسارات طالما لزم لتلبية طلبك والاحتفاظ بالسجلات التجارية وحل النزاعات. يمكنك طلب حذف بيانات الاتصال غير الأساسية حيث يسمح القانون المحلي.
                </p>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">اتصل بنا</h2>
                <p>
                  لأسئلة أو طلبات متعلقة بالخصوصية، راسل{" "}
                  <a href={`mailto:${SITE_CONTACT.email}`} class="text-primary hover:underline">{SITE_CONTACT.email}</a>.
                </p>
              </section>
            </>
          ) : (
            <>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">Overview</h2>
                <p>{intro}</p>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">Information We Collect</h2>
                <p class="mb-3">When you submit a quote or contact form, we may collect:</p>
                <ul class="list-disc pl-5 space-y-1 text-sm">
                  <li>Name, company, email address, and phone number</li>
                  <li>Product requirements, dimensions, quantities, and project notes you provide</li>
                  <li>Files you upload (for example, logo artwork for branded covers)</li>
                  <li>Basic technical data such as browser type and pages visited (standard server logs)</li>
                </ul>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">How We Use Your Information</h2>
                <ul class="list-disc pl-5 space-y-1 text-sm">
                  <li>Respond to inquiries and prepare quotes</li>
                  <li>Communicate about orders, samples, and production</li>
                  <li>Improve our website and customer service</li>
                  <li>Comply with legal obligations where applicable</li>
                </ul>
                <p class="mt-3">We do not sell your personal information to third parties.</p>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">Data Retention</h2>
                <p>
                  We retain inquiry records for as long as needed to fulfill your request, maintain business records,
                  and resolve disputes. You may ask us to delete non-essential contact data where local law allows.
                </p>
              </section>
              <section>
                <h2 class="text-xl font-display font-semibold text-foreground mb-3">Contact</h2>
                <p>
                  For privacy-related questions or requests, email{" "}
                  <a href={`mailto:${SITE_CONTACT.email}`} class="text-primary hover:underline">{SITE_CONTACT.email}</a>.
                </p>
              </section>
            </>
          )
        }

        <p class="text-sm">
          <a href={lp("/contact")} class="text-primary hover:underline">{t.nav.contact}</a> · <a href={lp("/")} class="text-primary hover:underline">{t.common.home}</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

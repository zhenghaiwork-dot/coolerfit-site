---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Input from "@/components/ui/Input.astro";
import Textarea from "@/components/ui/Textarea.astro";
import Label from "@/components/ui/Label.astro";
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import Icon from "@/components/Icon.astro";
import InquiryAntiSpamFields from "@/components/InquiryAntiSpamFields.astro";
import { organizationJsonLd, SITE_CONTACT, SITE_NAME, SITE_URL } from "@/lib/site";
import { parseQuotePrefill } from "@/lib/quote-link";
import { localizedPath, type Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui(locale);
const lp = (p: string) => localizedPath(locale, p);
const prefill = parseQuotePrefill(Astro.url.searchParams);
const contactJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: t.contact.heading,
  url: `${SITE_URL}${lp("/contact")}`,
  mainEntity: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
    contactPoint: {
      "@type": "ContactPoint",
      email: SITE_CONTACT.email,
      telephone: SITE_CONTACT.phone,
      contactType: "sales",
      availableLanguage: ["English", "Spanish", "Arabic"],
    },
  },
};
---

<BaseLayout
  title={`${t.contact.heading} | CoolerFit`}
  description={t.contact.subtext}
  canonicalPath={lp("/contact")}
  alternatePath="/contact"
  locale={locale}
  jsonLd={[organizationJsonLd(), contactJsonLd]}
  mobileCta={false}
>
  <div class="pt-24 md:pt-32 pb-20">
    <div class="container max-w-3xl">
      <div class="text-center mb-14">
        <span class="section-hd-label">{t.contact.label}</span>
        <h1 class="text-3xl md:text-5xl font-display font-bold text-foreground mb-4">{t.contact.heading}</h1>
        <p class="text-muted-foreground max-w-2xl mx-auto">{t.contact.subtext}</p>
      </div>

      {
        prefill && (
          <div
            class="mb-6 rounded-xl border border-primary/25 bg-primary/[0.06] px-5 py-4 text-start"
            data-quote-banner
          >
            <p class="text-sm font-semibold text-foreground">
              {t.contactPrefill.quotingFor}:{" "}
              <span class="text-primary">{prefill.summary || prefill.productName || prefill.categoryName}</span>
            </p>
            <p class="text-xs text-muted-foreground mt-1">{t.contactPrefill.contextHint}</p>
          </div>
        )
      }

      <Card class="border border-border/60 shadow-md">
        <CardContent class="p-8">
          <form
            class="relative space-y-6"
            data-contact-form
            data-locale={locale}
            data-sending={t.contact.sending}
            data-success={t.toast.quoteSent}
          >
            <InquiryAntiSpamFields />
            {
              prefill && (
                <>
                  <input type="hidden" name="productSlug" value={prefill.productSlug} />
                  <input type="hidden" name="productName" value={prefill.productName || prefill.summary} />
                  <input type="hidden" name="coverType" value={prefill.coverType || prefill.categoryName} />
                  <input type="hidden" name="categorySlug" value={prefill.categorySlug} />
                  <input type="hidden" name="refPath" value={prefill.ref} />
                </>
              )
            }
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <Label for="name">{t.form.name}</Label>
                <Input id="name" name="name" required maxlength={100} />
              </div>
              <div class="space-y-2">
                <Label for="email">{t.form.email}</Label>
                <Input id="email" name="email" type="email" required maxlength={255} />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <Label for="company">{t.form.company}</Label>
                <Input id="company" name="company" maxlength={100} />
              </div>
              <div class="space-y-2">
                <Label for="phone">{t.form.phone}</Label>
                <Input id="phone" name="phone" placeholder={SITE_CONTACT.phone} maxlength={20} />
              </div>
            </div>
            {
              (prefill?.coverType || prefill?.categoryName || prefill?.productName) && (
                <div class="space-y-2">
                  <Label for="coverTypeDisplay">{t.form.coverType}</Label>
                  <Input
                    id="coverTypeDisplay"
                    name="coverTypeDisplay"
                    value={prefill.coverType || prefill.categoryName || prefill.productName}
                    readonly
                  />
                </div>
              )
            }
            <div class="space-y-2">
              <Label for="details">{t.form.details}</Label>
              <Textarea id="details" name="details" rows={5} maxlength={2000} value={prefill?.details ?? ""} />
            </div>
            <Button type="submit" size="lg" data-contact-submit>
              <Icon name="Send" class="me-2" size={18} />
              <span data-submit-label>{t.contact.send}</span>
            </Button>
          </form>
        </CardContent>
      </Card>
    </div>
  </div>
</BaseLayout>

<script>
  import { submitInquiry, validateInquiryContact } from "@/lib/inquiry";
  import { clearInquirySource, getInquirySource } from "@/lib/inquiry-source";
  import { SITE_CONTACT } from "@/lib/site";
  import { toast } from "@/lib/toast";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
    const submitButton = form.querySelector<HTMLButtonElement>("[data-contact-submit]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const idle = submitLabel?.textContent ?? "Send";
    const sending = form.dataset.sending ?? "Sending…";
    const success = form.dataset.success ?? "Quote request sent";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const value = (name: string) => field(name)?.value.trim() ?? "";
      const err = validateInquiryContact(
        value("name"),
        value("email"),
        document.documentElement.getAttribute("data-locale") ?? "en",
      );
      if (err) {
        toast({ title: err, variant: "destructive" });
        return;
      }
      if (submitButton) submitButton.disabled = true;
      if (submitLabel) submitLabel.textContent = sending;
      const refPath = value("refPath");
      const inquirySource = getInquirySource();
      try {
        const result = await submitInquiry(
          {
            formType: "contact",
            name: value("name"),
            email: value("email"),
            phone: value("phone") || undefined,
            company: value("company") || undefined,
            message: value("details") || undefined,
            productSlug: value("productSlug") || undefined,
            productName: value("productName") || undefined,
            coverType: value("coverType") || value("coverTypeDisplay") || undefined,
            pageUrl: refPath || window.location.pathname,
            sourcePage: inquirySource?.page,
            sourcePosition: inquirySource?.position,
          },
          null,
          {
            formStartedAt: Number(field("formStartedAt")?.value ?? Date.now()),
            honeypot: field("website")?.value ?? "",
          },
        );
        if (result.ok) {
          clearInquirySource();
          toast({
            title: success,
            description: result.method === "api" && result.inquiryId
              ? `Reference: ${result.inquiryId} · ${SITE_CONTACT.email}`
              : `→ ${SITE_CONTACT.email}`,
          });
          form.dataset.submitted = "true";
          if (submitButton) submitButton.disabled = true;
          if (submitLabel) submitLabel.textContent = success;
        } else {
          toast({ title: result.error ?? "Error", variant: "destructive" });
        }
      } finally {
        if (submitButton && form.dataset.submitted !== "true") submitButton.disabled = false;
        if (submitLabel) submitLabel.textContent = idle;
      }
    });
  }
</script>

---
/** Link to locale /contact carrying quote context as query params for form pre-fill. */
import type { HTMLAttributes } from "astro/types";
import { buildQuoteUrl, type QuoteLinkInput } from "@/lib/quote-link";
import { defaultLocale, type Locale } from "@/i18n/locales";

type Props = HTMLAttributes<"a"> & {
  quote: QuoteLinkInput;
  locale?: Locale;
};

const { quote, locale: localeProp, ...rest } = Astro.props;
const locale =
  localeProp ??
  quote.locale ??
  (Astro.currentLocale as Locale | undefined) ??
  defaultLocale;
---

<a href={buildQuoteUrl({ ...quote, locale })} {...rest}>
  <slot />
</a>

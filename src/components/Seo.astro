---
/**
 * Head tags for a page. Emits the same set the react-helmet-async `Seo`
 * component produced, but at build time so crawlers see them in the raw HTML.
 */
import { DEFAULT_OG_IMAGE, SITE_NAME } from "@/lib/site";
import { toAbsoluteUrl, truncateMetaDescription, type JsonLd } from "@/lib/seo";
import {
  defaultLocale,
  localeMarkets,
  locales,
  localizedPath,
  stripLocalePrefix,
  type Locale,
} from "@/i18n/locales";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  imageUrl?: string;
  jsonLd?: JsonLd;
  noIndex?: boolean;
  locale?: Locale;
  /** Path without locale prefix, used for hreflang alternates. */
  alternatePath?: string;
}

const {
  title,
  description,
  canonicalPath,
  imageUrl,
  jsonLd,
  noIndex,
  locale = defaultLocale,
  alternatePath,
} = Astro.props;

const rawAlternate = alternatePath ?? canonicalPath ?? "/";
const pathForAlternates = stripLocalePrefix(rawAlternate) || "/";
const canonical = canonicalPath ? toAbsoluteUrl(canonicalPath) : undefined;
const ogImage = toAbsoluteUrl(imageUrl || DEFAULT_OG_IMAGE);
const metaDescription = description ? truncateMetaDescription(description) : undefined;
---

<title>{title}</title>
{metaDescription && <meta name="description" content={metaDescription} />}
{canonical && <link rel="canonical" href={canonical} />}

{
  locales.map((code) => (
    <link
      rel="alternate"
      hreflang={localeMarkets[code].hreflang}
      href={toAbsoluteUrl(localizedPath(code, pathForAlternates))}
    />
  ))
}
<link rel="alternate" hreflang="x-default" href={toAbsoluteUrl(localizedPath(defaultLocale, pathForAlternates))} />

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={localeMarkets[locale].ogLocale} />
{
  locales
    .filter((code) => code !== locale)
    .map((code) => <meta property="og:locale:alternate" content={localeMarkets[code].ogLocale} />)
}
<meta property="og:title" content={title} />
{metaDescription && <meta property="og:description" content={metaDescription} />}
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{metaDescription && <meta name="twitter:description" content={metaDescription} />}
<meta name="twitter:image" content={ogImage} />

{noIndex && <meta name="robots" content="noindex,nofollow" />}

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

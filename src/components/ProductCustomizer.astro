---
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import Label from "@/components/ui/Label.astro";
import Input from "@/components/ui/Input.astro";
import Textarea from "@/components/ui/Textarea.astro";
import Button from "@/components/ui/Button.astro";
import Select from "@/components/ui/Select.astro";
import Icon from "@/components/Icon.astro";
import InquiryAntiSpamFields from "@/components/InquiryAntiSpamFields.astro";
import QuoteLink from "@/components/QuoteLink.astro";
import { defaultLocale, localizedPath, type Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";

interface Props {
  productName: string;
  productSlug: string;
  locale?: Locale;
}

const { productName, productSlug, locale = defaultLocale } = Astro.props;
const t = ui(locale);
const lp = (path: string) => localizedPath(locale, path);

const PRESET_COLORS = [
  { name: "Charcoal", value: "#374151" },
  { name: "Navy", value: "#1e3a5f" },
  { name: "Gray", value: "#9ca3af" },
  { name: "Beige", value: "#d4c5a9" },
  { name: "Silver", value: "#c0c0c0" },
  { name: "Black", value: "#1a1a1a" },
  { name: "Forest Green", value: "#2d5a3d" },
  { name: "Desert Sand", value: "#c2a878" },
];

const materialOptions = [
  "600D Oxford Polyester",
  "900D Industrial Canvas",
  "300D Polyester + PVC",
  "420D Polyester",
  "High-Density Mesh",
  "Thermal Insulated Composite",
].map((m) => ({ value: m, label: m }));

const unitOptions = [
  { value: "cm", label: "cm" },
  { value: "in", label: "inch" },
  { value: "mm", label: "mm" },
];

const logoPositionOptions = [
  { value: "center", label: locale === "es" ? "Centro" : locale === "ar" ? "وسط" : "Center" },
  { value: "top-left", label: locale === "es" ? "Arriba izquierda" : locale === "ar" ? "أعلى اليسار" : "Top Left" },
  { value: "top-right", label: locale === "es" ? "Arriba derecha" : locale === "ar" ? "أعلى اليمين" : "Top Right" },
  {
    value: "bottom-center",
    label: locale === "es" ? "Abajo al centro" : locale === "ar" ? "أسفل الوسط" : "Bottom Center",
  },
  { value: "full", label: locale === "es" ? "Cubierta completa" : locale === "ar" ? "كامل الغطاء" : "Full Cover" },
];

const openingOptions = [
  { value: "none", label: locale === "es" ? "Sin aberturas" : locale === "ar" ? "بدون فتحات" : "No Openings" },
  {
    value: "vent-top",
    label: locale === "es" ? "Ventilación superior" : locale === "ar" ? "تهوية علوية" : "Top Ventilation",
  },
  {
    value: "vent-side",
    label: locale === "es" ? "Ventilación lateral" : locale === "ar" ? "تهوية جانبية" : "Side Ventilation",
  },
  { value: "pipe-cutout", label: locale === "es" ? "Corte para tubo" : locale === "ar" ? "فتحة أنبوب" : "Pipe Cutout" },
  {
    value: "drain-hole",
    label: locale === "es" ? "Orificio de drenaje" : locale === "ar" ? "فتحة تصريف" : "Drainage Hole",
  },
  {
    value: "full-custom",
    label: locale === "es" ? "Personalizado (describir abajo)" : locale === "ar" ? "مخصّص (صف أدناه)" : "Custom (Describe Below)",
  },
];
---

<Card
  id="inquiry"
  class="border border-primary/20 bg-primary/[0.02] scroll-mt-28 transition-shadow duration-300"
  data-customizer
  data-product-name={productName}
  data-product-slug={productSlug}
  data-msg-file-large={t.toast.fileTooLarge}
  data-msg-file-large-desc={t.toast.fileTooLargeDesc}
  data-msg-fill={t.toast.fillCustomization}
  data-msg-sending={t.contact.sending}
  data-msg-sent={t.toast.customSent}
  data-msg-sent-desc={t.toast.customSentDesc}
  data-msg-mailto={t.toast.completeMailto}
  data-msg-mailto-desc={t.toast.completeMailtoDesc}
  data-msg-fail={t.toast.couldNotSend}
  data-msg-fail-desc={t.toast.couldNotSendDesc}
  data-msg-error={t.toast.somethingWrong}
  data-msg-error-desc={t.toast.emailDirectly}
>
  <CardContent class="p-6 md:p-8">
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-2">
        <Icon name="Palette" size={20} class="text-primary" />
        <h3 class="text-xl font-display font-semibold text-foreground">{t.chrome.customizeThisCover}</h3>
      </div>
      <p class="text-sm text-muted-foreground">
        {t.chrome.customizeIntro}
      </p>
    </div>

    <form class="relative space-y-6" data-customizer-form>
      <InquiryAntiSpamFields />
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-4 rounded-lg bg-secondary/60 border border-border">
        <div class="space-y-2 sm:col-span-1">
          <Label for="custom-name">{t.form.name}</Label>
          <Input id="custom-name" name="name" maxlength={100} required />
        </div>
        <div class="space-y-2 sm:col-span-1">
          <Label for="custom-email">{t.form.email}</Label>
          <Input id="custom-email" name="email" type="email" maxlength={255} required />
        </div>
        <div class="space-y-2 sm:col-span-1">
          <Label for="custom-phone">{t.form.phone}</Label>
          <Input id="custom-phone" name="phone" maxlength={20} />
        </div>
      </div>

      <div>
        <Label class="text-sm font-medium text-foreground mb-3 flex items-center gap-1.5">
          <Icon name="Palette" size={14} class="text-primary" /> {t.chrome.color}
        </Label>
        <div class="flex flex-wrap gap-2 mt-2">
          {
            PRESET_COLORS.map((c) => (
              <button
                type="button"
                data-color-swatch
                data-color-name={c.name}
                data-color-value={c.value}
                class="w-11 h-11 rounded-full border-2 transition-all hover:scale-110 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border-border"
                style={`background-color: ${c.value}`}
                title={c.name}
              />
            ))
          }
          <div class="relative">
            <input
              type="color"
              value="#888888"
              data-custom-hex
              class="absolute inset-0 w-11 h-11 opacity-0 cursor-pointer"
              aria-label={t.common.customColor}
            />
            <div
              data-custom-hex-preview
              class="w-11 h-11 rounded-full border-2 flex items-center justify-center text-xs font-bold transition-all border-dashed border-muted-foreground/40"
            >
              <span class="text-muted-foreground" data-custom-hex-plus>+</span>
            </div>
          </div>
        </div>
        <p class="text-xs text-muted-foreground mt-2" data-color-label hidden>
          Selected: <span class="font-medium text-foreground" data-color-label-text></span>
        </p>
        <input type="hidden" name="color" value="" data-color-input />
      </div>

      <div>
        <Label class="text-sm font-medium text-foreground flex items-center gap-1.5">
          <Icon name="Layers" size={14} class="text-primary" /> {t.chrome.materialLabel}
        </Label>
        <Select name="material" class="mt-2" placeholder={t.chrome.materialLabel} options={materialOptions} />
      </div>

      <div>
        <Label class="text-sm font-medium text-foreground flex items-center gap-1.5">
          <Icon name="Ruler" size={14} class="text-primary" /> {t.chrome.dimensionsLabel}
        </Label>
        <div class="grid grid-cols-4 gap-2 mt-2">
          <Input name="width" placeholder={t.chrome.width} type="number" min="0" aria-label={t.chrome.width} />
          <Input name="height" placeholder={t.chrome.height} type="number" min="0" aria-label={t.chrome.height} />
          <Input name="depth" placeholder={t.chrome.depth} type="number" min="0" aria-label={t.chrome.depth} />
          <Select name="sizeUnit" options={unitOptions} value="cm" />
        </div>
      </div>

      <div>
        <Label class="text-sm font-medium text-foreground flex items-center gap-1.5">
          <Icon name="Image" size={14} class="text-primary" /> {t.chrome.logoPrinting}
        </Label>
        <div class="mt-2">
          <div class="flex items-start gap-4" data-logo-preview-wrap hidden>
            <div class="relative w-20 h-20 rounded-lg border border-border overflow-hidden bg-secondary">
              <img src="" alt="Logo preview" class="w-full h-full object-contain" width={80} height={80} data-logo-img />
              <button
                type="button"
                data-logo-remove
                class="absolute -top-1.5 -right-1.5 w-7 h-7 bg-destructive text-destructive-foreground rounded-full flex items-center justify-center hover:bg-destructive/90 transition-colors"
                aria-label={t.common.removeLogo}
              >
                <Icon name="X" size={14} />
              </button>
            </div>
            <div class="flex-1">
              <p class="text-sm text-foreground font-medium" data-logo-name></p>
              <p class="text-xs text-muted-foreground" data-logo-size></p>
              <Select
                name="logoPosition"
                class="mt-2"
                triggerClass="h-8 text-xs"
                placeholder={t.chrome.logoPosition}
                options={logoPositionOptions}
              />
            </div>
          </div>
          <button
            type="button"
            data-logo-trigger
            class="w-full border-2 border-dashed border-border rounded-lg p-6 text-center hover:border-primary/40 hover:bg-primary/[0.02] transition-colors"
          >
            <Icon name="Upload" size={24} class="mx-auto mb-2 text-muted-foreground" />
            <p class="text-sm text-muted-foreground">
              {locale === "es"
                ? "Haz clic para subir el arte del logo"
                : locale === "ar"
                  ? "انقر لرفع تصميم الشعار"
                  : "Click to upload logo artwork"}
            </p>
            <p class="text-xs text-muted-foreground/60 mt-1">
              PNG, JPG, SVG — Max 5MB
            </p>
          </button>
          <input type="file" accept="image/jpeg,image/png,image/webp,application/pdf" class="hidden" data-logo-input />
        </div>
      </div>

      <div>
        <Label class="text-sm font-medium text-foreground">{t.chrome.openingDesignLabel}</Label>
        <Select
          name="openingDesign"
          class="mt-2"
          placeholder={t.chrome.selectOpening}
          options={openingOptions}
        />
      </div>

      <div>
        <Label class="text-sm font-medium text-foreground">{t.chrome.additionalNotes}</Label>
        <Textarea
          name="notes"
          placeholder={t.chrome.notesPlaceholder}
          class="mt-2 min-h-[80px]"
          maxlength={1000}
        />
      </div>

      <Button type="submit" size="lg" class="w-full" data-customizer-submit>
        <Icon name="Send" size={16} class="me-2" />
        <span data-customizer-label>{t.chrome.requestCustomQuoteFor} {productName}</span>
      </Button>
      <p class="text-xs text-muted-foreground text-center">
        {t.chrome.customizerFooter}{" "}
        <QuoteLink
          locale={locale}
          quote={{
            productSlug,
            productName,
            ref: lp(`/product/${productSlug}`),
            locale,
          }}
          class="text-primary hover:underline font-medium"
        >
          {t.chrome.orSkipToQuote}
        </QuoteLink>
        .
      </p>
    </form>
  </CardContent>
</Card>

<script>
  import { submitInquiry, validateInquiryContact } from "@/lib/inquiry";
  import { clearInquirySource, getInquirySource } from "@/lib/inquiry-source";
  import { toast } from "@/lib/toast";
  import { cn } from "@/lib/utils";

  const root = document.querySelector<HTMLElement>("[data-customizer]");
  const form = root?.querySelector<HTMLFormElement>("[data-customizer-form]");
  if (!root || !form) throw new Error("ProductCustomizer missing");

  const productName = root.dataset.productName ?? "";
  const productSlug = root.dataset.productSlug ?? "";
  const msg = {
    fileLarge: root.dataset.msgFileLarge ?? "File too large",
    fileLargeDesc: root.dataset.msgFileLargeDesc ?? "Logo must be under 5MB.",
    fill: root.dataset.msgFill ?? "Please fill in at least one customization option",
    sending: root.dataset.msgSending ?? "Sending…",
    sent: root.dataset.msgSent ?? "Customization request sent",
    sentDesc: root.dataset.msgSentDesc ?? "",
    mailto: root.dataset.msgMailto ?? "Complete in your email app",
    mailtoDesc: root.dataset.msgMailtoDesc ?? "",
    fail: root.dataset.msgFail ?? "Could not send request",
    failDesc: root.dataset.msgFailDesc ?? "",
    error: root.dataset.msgError ?? "Something went wrong",
    errorDesc: root.dataset.msgErrorDesc ?? "",
  };

  const colorInput = form.querySelector<HTMLInputElement>("[data-color-input]")!;
  const colorLabel = form.querySelector<HTMLElement>("[data-color-label]")!;
  const colorLabelText = form.querySelector<HTMLElement>("[data-color-label-text]")!;
  const swatches = [...form.querySelectorAll<HTMLButtonElement>("[data-color-swatch]")];
  const customHex = form.querySelector<HTMLInputElement>("[data-custom-hex]")!;
  const customPreview = form.querySelector<HTMLElement>("[data-custom-hex-preview]")!;
  const customPlus = form.querySelector<HTMLElement>("[data-custom-hex-plus]")!;

  const logoInput = form.querySelector<HTMLInputElement>("[data-logo-input]")!;
  const logoTrigger = form.querySelector<HTMLButtonElement>("[data-logo-trigger]")!;
  const logoPreviewWrap = form.querySelector<HTMLElement>("[data-logo-preview-wrap]")!;
  const logoImg = form.querySelector<HTMLImageElement>("[data-logo-img]")!;
  const logoName = form.querySelector<HTMLElement>("[data-logo-name]")!;
  const logoSize = form.querySelector<HTMLElement>("[data-logo-size]")!;
  const logoRemove = form.querySelector<HTMLButtonElement>("[data-logo-remove]")!;
  let logoFile: File | null = null;

  const submitButton = form.querySelector<HTMLButtonElement>("[data-customizer-submit]")!;
  const submitLabel = form.querySelector<HTMLElement>("[data-customizer-label]")!;
  const idleLabel = submitLabel.textContent ?? "";

  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
  const value = (name: string) => field(name)?.value.trim() ?? "";

  const setColor = (hex: string, label: string, isCustom: boolean) => {
    colorInput.value = hex;
    swatches.forEach((s) => {
      const on = !isCustom && s.dataset.colorValue === hex;
      s.className = cn(
        "w-11 h-11 rounded-full border-2 transition-all hover:scale-110 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
        on ? "border-primary ring-2 ring-primary/30 scale-110" : "border-border",
      );
    });
    customPreview.className = cn(
      "w-11 h-11 rounded-full border-2 flex items-center justify-center text-xs font-bold transition-all",
      isCustom ? "border-primary ring-2 ring-primary/30" : "border-dashed border-muted-foreground/40",
    );
    customPreview.style.backgroundColor = isCustom ? hex : "transparent";
    if (customPlus) customPlus.hidden = isCustom;
    if (hex) {
      colorLabel.hidden = false;
      colorLabelText.textContent = label;
    } else {
      colorLabel.hidden = true;
    }
  };

  swatches.forEach((s) => {
    s.addEventListener("click", () => {
      customHex.value = "#888888";
      setColor(s.dataset.colorValue ?? "", s.dataset.colorName ?? "", false);
    });
  });

  customHex.addEventListener("input", () => {
    setColor(customHex.value, customHex.value, true);
  });

  logoTrigger.addEventListener("click", () => logoInput.click());

  logoInput.addEventListener("change", () => {
    const file = logoInput.files?.[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) {
      toast({ title: msg.fileLarge, description: msg.fileLargeDesc, variant: "destructive" });
      logoInput.value = "";
      return;
    }
    logoFile = file;
    logoName.textContent = file.name;
    logoSize.textContent = `${(file.size / 1024).toFixed(0)} KB`;
    const reader = new FileReader();
    reader.onload = () => {
      logoImg.src = String(reader.result);
      logoPreviewWrap.hidden = false;
      logoTrigger.hidden = true;
    };
    reader.readAsDataURL(file);
  });

  logoRemove.addEventListener("click", () => {
    logoFile = null;
    logoInput.value = "";
    logoImg.src = "";
    logoPreviewWrap.hidden = true;
    logoTrigger.hidden = false;
  });

  // Hero CTA scrolls here and briefly highlights the card.
  if (window.location.hash === "#inquiry") {
    requestAnimationFrame(() => {
      root.classList.add("ring-2", "ring-primary/60", "ring-offset-2", "shadow-lg");
      root.scrollIntoView({ behavior: "smooth", block: "start" });
      window.setTimeout(() => {
        root.classList.remove("ring-2", "ring-primary/60", "ring-offset-2", "shadow-lg");
      }, 2000);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-scroll-inquiry]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      root.scrollIntoView({ behavior: "smooth", block: "start" });
      root.classList.add("ring-2", "ring-primary/60", "ring-offset-2", "shadow-lg");
      window.setTimeout(() => {
        root.classList.remove("ring-2", "ring-primary/60", "ring-offset-2", "shadow-lg");
      }, 2000);
      history.replaceState(null, "", "#inquiry");
    });
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const err = validateInquiryContact(value("name"), value("email"), document.documentElement.getAttribute("data-locale") ?? "en");
    if (err) {
      toast({ title: err, variant: "destructive" });
      return;
    }
    if (
      !value("material") &&
      !value("width") &&
      !colorInput.value &&
      !logoFile &&
      !value("notes") &&
      !value("openingDesign")
    ) {
      toast({ title: msg.fill, variant: "destructive" });
      return;
    }

    submitButton.disabled = true;
    submitLabel.textContent = msg.sending;
    const inquirySource = getInquirySource();

    try {
      const result = await submitInquiry(
        {
          formType: "custom",
          name: value("name"),
          email: value("email"),
          phone: value("phone") || undefined,
          productName,
          productSlug,
          material: value("material") || undefined,
          color: colorLabelText.textContent || colorInput.value || undefined,
          width: value("width") || undefined,
          height: value("height") || undefined,
          depth: value("depth") || undefined,
          sizeUnit: value("sizeUnit") || "cm",
          logoPosition: value("logoPosition") || undefined,
          openingDesign: value("openingDesign") || undefined,
          notes: value("notes") || undefined,
          pageUrl: window.location.pathname,
          sourcePage: inquirySource?.page,
          sourcePosition: inquirySource?.position ?? "product-customizer-form",
        },
        logoFile,
        {
          formStartedAt: Number(field("formStartedAt")?.value ?? Date.now()),
          honeypot: field("website")?.value ?? "",
        },
      );

      if (result.ok && result.method === "api") {
        clearInquirySource();
        toast({
          title: msg.sent,
          description: result.inquiryId ? `Reference: ${result.inquiryId}` : msg.sentDesc,
        });
        const notes = field("notes");
        if (notes) notes.value = "";
      } else if (result.ok && result.method === "mailto") {
        toast({
          title: msg.mailto,
          description: msg.mailtoDesc,
        });
      } else {
        toast({
          title: msg.fail,
          description: result.error ?? msg.failDesc,
          variant: "destructive",
        });
      }
    } catch {
      toast({ title: msg.error, description: msg.errorDesc, variant: "destructive" });
    } finally {
      submitButton.disabled = false;
      submitLabel.textContent = idleLabel;
    }
  });
</script>

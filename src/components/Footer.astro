---
import Icon from "@/components/Icon.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { SITE_CONTACT } from "@/lib/site";
import { categorySlug, getCategoryEntries } from "@/lib/content";
import { defaultLocale, localizedPath, type Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = ui(locale);
const lp = (path: string) => localizedPath(locale, path);

const categories = await getCategoryEntries(locale);
const titleBySlug = Object.fromEntries(categories.map((c) => [categorySlug(c), c.data.title]));

const quickLinks = [
  { label: t.nav.products, path: "/products" },
  { label: t.nav.customSolutions, path: "/custom-solutions" },
  { label: t.nav.about, path: "/about" },
  { label: t.nav.contact, path: "/contact" },
];

const productSlugs = [
  "evaporative-cooler-covers",
  "uv-resistant-cooler-covers",
  "waterproof-cooler-covers",
  "winter-cooler-covers",
  "custom-size-cooler-covers",
  "oversized-cooler-covers",
] as const;

const productLinks = productSlugs.map((slug) => ({
  label: titleBySlug[slug] ?? slug,
  path: `/products/${slug}`,
}));

const resourceLinks = [
  { label: t.nav.blog, path: "/blog" },
  { label: t.chrome.materialsGuide, path: "/materials" },
  { label: t.chrome.installationGuide, path: "/resources/installation" },
  { label: t.chrome.maintenanceGuide, path: "/resources/maintenance" },
  { label: t.chrome.howToMeasure, path: "/sizes/how-to-measure" },
  { label: t.common.siteMap, path: "/sitemap" },
];

const linkClass =
  "text-sm opacity-80 hover:opacity-100 hover:translate-x-0.5 rtl:hover:-translate-x-0.5 transition-all duration-200 inline-block";
const headingClass = "font-display font-semibold text-xs uppercase tracking-widest mb-4 opacity-70";
const contactItemClass = "flex items-start gap-3 text-sm opacity-80 hover:opacity-100 transition-opacity duration-200";

const year = new Date().getFullYear();
---

<footer class="bg-foreground text-background relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none">
    <div
      class="w-full h-full"
      style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>
  </div>

  <div class="container relative py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <div class="lg:col-span-1">
        <a href={lp("/")} class="inline-flex items-center gap-2.5 mb-4 group" aria-label="CoolerFit">
          <svg viewBox="0 0 124 124" width="36" height="36" class="shrink-0" aria-hidden="true">
            <defs>
              <linearGradient id="footer-logo-g" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#1B8CE3"></stop>
                <stop offset="100%" stop-color="#2EB89E"></stop>
              </linearGradient>
            </defs>
            <rect x="12" y="12" width="100" height="100" rx="21" fill="url(#footer-logo-g)"></rect>
            <rect x="33" y="39" width="10" height="45" rx="5" fill="#FFFFFF"></rect>
            <path d="M 40 50 Q 62 41 87 50" stroke="#FFFFFF" stroke-width="8" stroke-linecap="round" fill="none"></path>
            <path d="M 40 62 Q 59 58 79 62" stroke="#FFFFFF" stroke-width="8" stroke-linecap="round" fill="none"></path>
            <path d="M 40 74 Q 62 71 87 74" stroke="#FFFFFF" stroke-width="8" stroke-linecap="round" fill="none"></path>
          </svg>
          <span class="font-display font-extrabold text-xl tracking-tight text-background group-hover:opacity-90 transition-opacity">
            CoolerFit
          </span>
        </a>
        <p class="text-sm opacity-80 leading-relaxed mb-4">
          {t.chrome.tagline}
        </p>
        <LanguageSwitcher locale={locale} />
      </div>

      <div>
        <h3 class={headingClass}>{t.chrome.quickLinks}</h3>
        <ul class="space-y-2.5">
          {
            quickLinks.map((l) => (
              <li>
                <a href={lp(l.path)} class={linkClass}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class={headingClass}>{t.nav.products}</h3>
        <ul class="space-y-2.5">
          {
            productLinks.map((l) => (
              <li>
                <a href={lp(l.path)} class={linkClass}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class={headingClass}>{t.nav.resources}</h3>
        <ul class="space-y-2.5">
          {
            resourceLinks.map((l) => (
              <li>
                <a href={lp(l.path)} class={linkClass}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class={headingClass}>{t.chrome.contactHeading}</h3>
        <ul class="space-y-3">
          <li class={contactItemClass}>
            <Icon name="Mail" size={16} class="mt-0.5 shrink-0 opacity-50" />
            <a href={`mailto:${SITE_CONTACT.email}`} class="hover:underline">{SITE_CONTACT.email}</a>
          </li>
          <li class={contactItemClass}>
            <Icon name="Phone" size={16} class="mt-0.5 shrink-0 opacity-50" />
            <a href={`tel:${SITE_CONTACT.phone.replace(/[^\d+]/g, "")}`} class="hover:underline">{SITE_CONTACT.phone}</a>
          </li>
          <li class={contactItemClass}>
            <Icon name="MapPin" size={16} class="mt-0.5 shrink-0 opacity-50" />
            <span>{SITE_CONTACT.address}</span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-background/8 mt-14 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm opacity-70"
    >
      <span>© {year} CoolerFit. {t.common.allRights}</span>
      <a href={lp("/privacy")} class="hover:opacity-70 transition-opacity duration-200">{t.common.privacy}</a>
    </div>
  </div>
</footer>

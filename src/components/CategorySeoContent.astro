---
/**
 * Long-form category copy plus the FAQ block. Renders nothing for categories
 * without `seoContent`.
 */
import Icon from "@/components/Icon.astro";
import FaqAccordion from "@/components/ui/FaqAccordion.astro";
import type { ProductCategory } from "@/data/products";
import { defaultLocale, type Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";

interface Props {
  product: ProductCategory;
  locale?: Locale;
}

const { product, locale = defaultLocale } = Astro.props;
const t = ui(locale);
const seo = product.seoContent;

const faqJsonLd =
  seo && seo.faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: seo.faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;
---

{
  seo && (
    <section
      data-pattern="category-seo"
      data-pattern-category="content"
      class="mb-12 border-t border-border pt-12"
    >
      <article class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-display font-semibold text-foreground mb-4">
          {t.chrome.aboutPrefix} {product.title}
        </h2>
        <p class="text-muted-foreground mb-8 leading-relaxed">{seo.intro}</p>

        {seo.highlights.length > 0 && (
          <ul class="space-y-2 mb-10">
            {seo.highlights.map((h) => (
              <li class="flex items-start gap-2 text-sm text-foreground">
                <Icon name="CheckCircle" size={16} class="text-primary shrink-0 mt-0.5" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        )}

        {seo.faqs.length > 0 && (
          <Fragment>
            <h3 class="text-xl font-display font-semibold text-foreground mb-4">{t.chrome.faqs}</h3>
            <FaqAccordion faqs={seo.faqs} />
          </Fragment>
        )}
      </article>

      {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />}
    </section>
  )
}

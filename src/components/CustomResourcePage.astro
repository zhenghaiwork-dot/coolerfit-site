---
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import Button from "@/components/ui/Button.astro";
import { buttonVariants } from "@/components/ui/button-variants";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import Icon from "@/components/Icon.astro";
import InternalLinkCard from "@/components/InternalLinkCard.astro";
import ProductImage from "@/components/ProductImage.astro";
import QuoteLink from "@/components/QuoteLink.astro";
import type { ResourcePage } from "@/data/resources";
import { getCustomPageMeta, getCustomPages } from "@/lib/custom-pages";
import { cn } from "@/lib/utils";
import { defaultLocale, localizedPath, type Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";

interface Props {
  resource: ResourcePage;
  slug: string;
  locale?: Locale;
}

const { resource, slug, locale = defaultLocale } = Astro.props;
const t = ui(locale);
const lp = (path: string) => localizedPath(locale, path);

const pageMeta = getCustomPageMeta(slug, t);
const CUSTOM_PAGES = getCustomPages(t);
const badgeIcon = pageMeta?.icon;
const highlights = resource.sections[0]?.bullets?.slice(0, 3) ?? [];

const materialRows: [string, string, string][] = [
  ["600D Oxford + PU", "General outdoor, Southwest winter", "Water-resistant"],
  ["900D + TPU", "Industrial / XL cabinets", "Heavy-duty WR"],
  ["PVC-backed vinyl", "Coastal rain, flat rooftops", "Waterproof"],
  ["Insulated laminate", "Cold-climate shutdown", "Thermal + WR"],
];

const deepDiveSlug =
  slug === "custom/materials"
    ? "custom-cover-materials"
    : slug === "custom/sizes"
      ? "custom-cover-sizes"
      : slug === "custom/opening-design"
        ? "custom-opening-designs"
        : "logo-printing-on-cooler-covers";
---

<div class="pt-24 md:pt-28 pb-20">
  {/* Hero */}
  <section class="relative overflow-hidden border-b border-border">
    <div
      class={cn(
        "absolute inset-0 bg-gradient-to-br pointer-events-none",
        pageMeta?.accent ?? "from-primary/10 via-secondary to-background",
      )}
      aria-hidden="true"></div>
    <div
      class="absolute -top-24 right-0 h-64 w-64 rounded-full bg-primary/5 blur-3xl pointer-events-none"
      aria-hidden="true"></div>
    <div class="container relative py-10 md:py-14">
      <Breadcrumb
        class="mb-6"
        items={[
          { label: t.common.home, href: lp("/") },
          { label: t.nav.custom, href: lp("/custom-solutions") },
          { label: pageMeta?.shortLabel ?? resource.title },
        ]}
      />

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_minmax(0,420px)] gap-10 items-center">
        <div>
          {
            badgeIcon ? (
              <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-card/80 backdrop-blur-sm px-3 py-1.5 text-xs font-semibold text-primary uppercase tracking-wider mb-4 shadow-xs">
                <Icon name={badgeIcon} size={14} />
                Custom Manufacturing
              </div>
            ) : null
          }
          <h1 class="text-3xl md:text-[2.75rem] font-display font-bold text-foreground mb-4 leading-[1.12] tracking-tight">
            {resource.title}
          </h1>
          <p class="text-lg text-muted-foreground leading-relaxed max-w-xl">{resource.description}</p>
          {
            resource.intro ? (
              <p class="mt-4 text-sm text-muted-foreground leading-relaxed max-w-xl">{resource.intro}</p>
            ) : null
          }
          <div class="mt-8 flex flex-wrap gap-3">
            <QuoteLink
              quote={{
                coverType: resource.title,
                ref: lp(`/${resource.slug}`),
              }}
              class={cn(buttonVariants({ size: "lg" }), "shadow-md")}
            >
              {t.nav.requestQuote} <Icon name="ArrowRight" class="ms-2" size={18} />
            </QuoteLink>
            <Button
              href={lp("/products/custom-evaporative-cooler-covers")}
              size="lg"
              variant="outline"
              class="bg-card/60 backdrop-blur-sm"
            >
              {t.nav.products}
            </Button>
          </div>
        </div>

        {
          pageMeta ? (
            <figure class="aspect-[4/3] overflow-hidden rounded-2xl bg-card shadow-[var(--shadow-lg)] ring-1 ring-border/50">
              <ProductImage
                src={pageMeta.hero.src}
                alt={pageMeta.hero.alt}
                width={840}
                height={630}
                pendingLabel={pageMeta.shortLabel}
                class="w-full h-full min-h-[240px]"
                imgClass="object-cover"
              />
            </figure>
          ) : null
        }
      </div>
    </div>
  </section>

  {/* Topic hub — visual cards instead of plain pills */}
  <section class="container py-8 md:py-10">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
      <div>
        <p class="section-hd-label">Customize Your Cover</p>
        <h2 class="text-xl font-display font-semibold text-foreground">Pick a specification area</h2>
      </div>
      <a href={lp("/custom-solutions")} class="text-sm font-medium text-primary hover:underline inline-flex items-center gap-1">
        {t.chrome.customOverview} <Icon name="ChevronRight" size={14} />
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
      {
        CUSTOM_PAGES.map((page) => {
          const active = slug === page.slug;
          return (
            <a
              href={lp(`/${page.slug}`)}
              class={cn(
                "group relative flex flex-col rounded-xl border p-4 transition-all duration-200",
                active
                  ? "border-primary bg-primary/[0.06] shadow-md ring-1 ring-primary/20"
                  : "border-border/70 bg-card hover:border-primary/30 hover:shadow-md hover:-translate-y-0.5",
              )}
            >
              <div
                class={cn(
                  "mb-3 flex h-10 w-10 items-center justify-center rounded-lg transition-colors",
                  active ? "bg-primary text-primary-foreground" : "bg-secondary text-primary group-hover:bg-primary/10",
                )}
              >
                <Icon name={page.icon} size={18} />
              </div>
              <p class={cn("font-display font-semibold text-sm", active ? "text-primary" : "text-foreground")}>
                {page.shortLabel}
              </p>
              <p class="mt-1 text-xs text-muted-foreground leading-relaxed line-clamp-2">{page.description}</p>
              {active ? (
                <span class="mt-3 text-[10px] font-semibold uppercase tracking-wider text-primary">Current page</span>
              ) : (
                <span class="mt-3 text-xs font-medium text-primary opacity-0 group-hover:opacity-100 transition-opacity">
                  Explore →
                </span>
              )}
            </a>
          );
        })
      }
    </div>

    {
      highlights.length > 0 ? (
        <ul class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-3">
          {highlights.map((item) => (
            <li class="flex items-start gap-2.5 rounded-xl border border-border/60 bg-card px-4 py-3 text-sm text-foreground shadow-xs">
              <Icon name="CheckCircle" size={16} class="text-primary shrink-0 mt-0.5" />
              <span class="leading-snug">{item}</span>
            </li>
          ))}
        </ul>
      ) : null
    }
  </section>

  {/* Main content + sticky sidebar */}
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-10 lg:gap-14">
      <div class="space-y-6 min-w-0">
        {
          resource.sections.map((section, i) => (
            <section
              id={`section-${i}`}
              class="rounded-2xl border border-border/70 bg-card shadow-xs overflow-hidden scroll-mt-28"
            >
              <div class="border-b border-border/60 bg-secondary/40 px-6 py-5 md:px-8">
                <div class="flex items-start gap-4">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground font-display text-sm font-bold">
                    {i + 1}
                  </span>
                  <h2 class="text-xl md:text-2xl font-display font-semibold text-foreground leading-tight pt-0.5">
                    {section.heading}
                  </h2>
                </div>
              </div>
              <div class="px-6 py-6 md:px-8 md:py-7">
                <p class="text-muted-foreground leading-relaxed mb-4">{section.body}</p>
                {section.bullets && section.bullets.length > 0 ? (
                  <ul class="grid gap-2 sm:grid-cols-2">
                    {section.bullets.map((item) => (
                      <li class="flex items-start gap-2.5 rounded-lg bg-secondary/50 px-3 py-2.5 text-sm text-foreground">
                        <Icon name="CheckCircle" size={15} class="text-primary shrink-0 mt-0.5" />
                        <span class="leading-snug">{item}</span>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </div>
            </section>
          ))
        }

        {
          slug === "custom/materials" ? (
            <div class="rounded-2xl border border-border/70 bg-card shadow-xs overflow-hidden">
              <div class="border-b border-border/60 px-6 py-4 md:px-8">
                <h2 class="text-lg font-display font-semibold text-foreground">Quick material comparison</h2>
                <p class="text-sm text-muted-foreground mt-1">At-a-glance specs for common custom fabric codes.</p>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-border bg-secondary/50">
                      <th class="px-4 py-3 text-left font-semibold text-foreground" scope="col">
                        Fabric
                      </th>
                      <th class="px-4 py-3 text-left font-semibold text-foreground" scope="col">
                        Best for
                      </th>
                      <th class="px-4 py-3 text-left font-semibold text-foreground" scope="col">
                        Rating
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {materialRows.map(([fabric, use, rating]) => (
                      <tr class="border-b border-border last:border-0">
                        <th
                          class="px-4 py-3 text-left font-medium text-foreground align-top whitespace-nowrap"
                          scope="row"
                        >
                          {fabric}
                        </th>
                        <td class="px-4 py-3 text-muted-foreground align-top">{use}</td>
                        <td class="px-4 py-3 text-muted-foreground align-top">{rating}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ) : null
        }
      </div>

      <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
        <Card class="border border-border/70 shadow-xs">
          <CardContent class="p-4">
            <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">On this page</p>
            <nav class="space-y-1" aria-label="Page sections">
              {
                resource.sections.map((section, i) => (
                  <a
                    href={`#section-${i}`}
                    class="block rounded-md px-2 py-1.5 text-sm text-muted-foreground hover:text-primary hover:bg-primary/5 transition-colors"
                  >
                    {section.heading}
                  </a>
                ))
              }
            </nav>
          </CardContent>
        </Card>

        <Card class="border border-primary/20 bg-primary/[0.04] shadow-xs">
          <CardContent class="p-5">
            <p class="font-display font-semibold text-foreground text-sm mb-2">Need help specifying?</p>
            <p class="text-xs text-muted-foreground leading-relaxed mb-4">
              Send dimensions, photos, or artwork — we confirm specs and reply within 24 hours. MOQ from 1 unit.
            </p>
            <QuoteLink
              quote={{ coverType: resource.title, ref: `/${resource.slug}` }}
              class={cn(buttonVariants({ size: "sm" }), "w-full")}
            >
              Request a Quote
            </QuoteLink>
          </CardContent>
        </Card>

        <Card class="border border-border/70 shadow-xs">
          <CardContent class="p-4">
            <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">Deep dive</p>
            <a href={lp(`/blog/${deepDiveSlug}`)} class="text-sm font-medium text-primary hover:underline">
              Read the full blog guide →
            </a>
          </CardContent>
        </Card>
      </aside>
    </div>
  </div>

  {
    resource.relatedLinks.length > 0 ? (
      <div class="container mt-14 md:mt-16">
        <h2 class="text-2xl font-display font-semibold text-foreground mb-5">Related Resources</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {resource.relatedLinks.map((link) => (
            <InternalLinkCard label={link.label} path={lp(link.path)} />
          ))}
        </div>
      </div>
    ) : null
  }

  <div class="container mt-14 md:mt-16">
    <div class="relative overflow-hidden rounded-2xl bg-foreground text-background p-10 md:p-14 text-center">
      <div
        class="absolute inset-0 bg-gradient-to-br from-primary/20 via-transparent to-accent/10 pointer-events-none"
        aria-hidden="true"></div>
      <div class="relative">
        <h2 class="text-2xl md:text-3xl font-display font-bold mb-3">Ready to Specify Your Cover?</h2>
        <p class="text-background/75 max-w-xl mx-auto mb-8 text-sm md:text-base leading-relaxed">
          Send dimensions, material choice, opening layout, or logo artwork — we confirm specs and reply with a quote
          within 24 hours.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <QuoteLink
            quote={{ coverType: resource.title, ref: lp(`/${resource.slug}`) }}
            class={buttonVariants({ size: "lg", variant: "secondary" })}
          >
            {t.chrome.requestQuote}
          </QuoteLink>
          <Button
            href={lp("/custom-solutions")}
            size="lg"
            variant="outline"
            class="border-background/30 bg-transparent text-background hover:bg-background/10 hover:text-background"
          >
            {t.chrome.customOverview}
          </Button>
        </div>
      </div>
    </div>
  </div>
</div>

---
/**
 * Page shell: html/head boilerplate, header, footer and toast viewport.
 */
import Seo from "@/components/Seo.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Toaster from "@/components/Toaster.astro";
import type { JsonLd } from "@/lib/seo";
import { defaultLocale, localeDirs, localeHtmlLang, type Locale } from "@/i18n/locales";
import { localeRedirectInlineScript } from "@/scripts/locale-redirect.inline";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  imageUrl?: string;
  jsonLd?: JsonLd;
  noIndex?: boolean;
  locale?: Locale;
  /** Path without locale prefix for hreflang. */
  alternatePath?: string;
}

const {
  title,
  description,
  canonicalPath,
  imageUrl,
  jsonLd,
  noIndex,
  locale = (Astro.currentLocale as Locale | undefined) ?? defaultLocale,
  alternatePath,
} = Astro.props;

const dir = localeDirs[locale];
const lang = localeHtmlLang[locale];
---

<!doctype html>
<html lang={lang} dir={dir} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="CoolerFit" />
    {/* Browser-language redirect: skips bots; honors coolerfit_lang; ?nolang=1 to skip */}
    <script is:inline set:html={localeRedirectInlineScript} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
    />
    {
      locale === "ar" && (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap"
        />
      )
    }

    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      imageUrl={imageUrl}
      jsonLd={jsonLd}
      noIndex={noIndex}
      locale={locale}
      alternatePath={alternatePath ?? canonicalPath}
    />
  </head>

  <body class:list={[locale === "ar" && "font-arabic"]}>
    <div class="min-h-screen flex flex-col">
      <Header locale={locale} />
      <main class="flex-1">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
    <Toaster />
  </body>
</html>

<style is:global>
  .font-arabic {
    font-family: "Noto Sans Arabic", "Plus Jakarta Sans", system-ui, sans-serif;
  }
</style>

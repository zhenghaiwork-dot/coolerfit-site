---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
---

<BaseLayout
  title="Page Not Found | CoolerFit"
  description="The page you requested could not be found. Browse products, resources, or contact CoolerFit for custom cooler cover quotes."
  canonicalPath="/404"
  noIndex
>
  <div class="pt-24 md:pt-32 pb-20">
    <div class="container text-center max-w-lg mx-auto">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">404</p>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-foreground mb-4">Page Not Found</h1>
      <p class="text-muted-foreground mb-8 leading-relaxed">
        The page <span class="font-mono text-sm text-foreground" data-requested-path></span> does not exist or
        may have moved.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button href="/">Back to Home</Button>
        <Button variant="outline" href="/products">Browse Products</Button>
        <Button variant="outline" href="/contact">Get a Quote</Button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // The React page read the attempted route from the router; on a static 404 it
  // is only knowable in the browser.
  const target = document.querySelector<HTMLElement>("[data-requested-path]");
  if (target) target.textContent = window.location.pathname;
</script>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/lib/icons";

const stats: { icon: IconName; value: string; label: string }[] = [
  { icon: "Factory", value: "10,000+", label: "Sq. Meters Factory" },
  { icon: "Users", value: "200+", label: "Skilled Workers" },
  { icon: "Award", value: "15+", label: "Years Experience" },
  { icon: "Globe", value: "50+", label: "Countries Served" },
];

const advantages: { icon: IconName; title: string; desc: string }[] = [
  { icon: "ShieldCheck", title: "Quality Assurance", desc: "ISO 9001 certified manufacturing with rigorous quality control at every stage." },
  { icon: "Factory", title: "Advanced Equipment", desc: "State-of-the-art cutting, sewing, and printing machinery for precision manufacturing." },
  { icon: "Truck", title: "Fast Turnaround", desc: "Efficient production lines enable quick delivery without compromising quality." },
  { icon: "Globe", title: "Global Shipping", desc: "Reliable logistics partners for worldwide delivery with full tracking." },
];

const facilityPhotos = [
  {
    src: "/images/about/production-line.webp",
    alt: "CoolerFit production line sewing custom evaporative cooler covers",
    label: "Production Line",
  },
  {
    src: "/images/about/quality-control.webp",
    alt: "Quality control inspection of cooler cover stitching and dimensions",
    label: "Quality Control",
  },
  {
    src: "/images/about/warehouse.webp",
    alt: "CoolerFit warehouse with packaged cooler covers ready for shipping",
    label: "Warehouse",
  },
] as const;
---

<BaseLayout
  title="About CoolerFit | Custom Evaporative Cooler Cover Manufacturer"
  description="CoolerFit manufactures custom evaporative cooler covers for HVAC contractors, property managers, and distributors worldwide since 2009."
  canonicalPath="/about"
>
  <div class="pt-24 md:pt-32 pb-20">
    <div class="container">
      <div class="text-center mb-14">
        <span class="section-hd-label">About Us</span>
        <h1 class="text-3xl md:text-5xl font-display font-bold text-foreground mb-4">About CoolerFit</h1>
        <p class="text-muted-foreground max-w-2xl mx-auto text-lg leading-relaxed">We are a specialized manufacturer of custom evaporative cooler covers, serving businesses worldwide with premium protective solutions since 2009.</p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
        {stats.map((s) => (
          <Card class="border border-border/60 shadow-xs text-center hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <CardContent class="p-8">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary/8 to-primary-accent flex items-center justify-center mx-auto mb-3">
                <Icon name={s.icon} class="text-primary" size={24} />
              </div>
              <div class="text-3xl font-display font-bold text-foreground mb-1">{s.value}</div>
              <p class="text-sm text-muted-foreground">{s.label}</p>
            </CardContent>
          </Card>
        ))}
      </div>

      <div class="mb-20">
        <div class="relative py-12 mb-8 section-edge">
          <div class="section-hd">
            <h2>Our Manufacturing Facility</h2>
            <p>State-of-the-art production lines with rigorous quality standards.</p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {facilityPhotos.map((photo) => (
            <figure class="relative aspect-video overflow-hidden rounded-xl bg-secondary group">
              <img
                src={photo.src}
                alt={photo.alt}
                width={1200}
                height={675}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              />
              <figcaption class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-foreground/70 to-transparent">
                <span class="text-background text-xs font-medium">{photo.label}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="relative py-12 section-edge">
        <div class="section-hd">
          <h2>Why Partner With Us</h2>
          <p>Dedicated manufacturing partner for your cooler cover needs.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {advantages.map((a) => (
            <Card class="border border-border/60 shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
              <CardContent class="p-8 flex gap-5">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary/8 to-primary-accent flex items-center justify-center shrink-0">
                  <Icon name={a.icon} class="text-primary" size={24} />
                </div>
                <div>
                  <h3 class="font-display font-semibold text-foreground mb-1.5">{a.title}</h3>
                  <p class="text-sm text-muted-foreground leading-relaxed">{a.desc}</p>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

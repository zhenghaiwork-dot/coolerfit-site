---
import ProductsCategoryPage from "@/templates/ProductsCategoryPage.astro";
import { categorySlug, getCategoryEntries } from "@/lib/content";

export async function getStaticPaths() {
  const entries = await getCategoryEntries("en");
  return entries.map((e) => ({
    params: { id: categorySlug(e) },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
---
<ProductsCategoryPage locale="en" entry={entry} />

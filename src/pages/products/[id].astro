---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import Icon from "@/components/Icon.astro";
import InternalLinkCard from "@/components/InternalLinkCard.astro";
import CategorySeoContent from "@/components/CategorySeoContent.astro";
import ProductImageCard from "@/components/ProductImageCard.astro";
import QuoteLink from "@/components/QuoteLink.astro";
import { buttonVariants } from "@/components/ui/button-variants";
import { getBlogBySlug, type BlogPost } from "@/data/blog";
import { productCategories, getProductBySlug, type ProductCategory } from "@/data/products";
import { getProductItemsByCategory } from "@/data/product-items";
import { categoryPageH1 } from "@/lib/category-seo";
import { cn } from "@/lib/utils";

export async function getStaticPaths() {
  // Synonym slugs are their own entries in `productCategories`, so they get a
  // page too; anything else falls through to 404.astro.
  return productCategories.map((category) => ({
    params: { id: category.slug },
    props: { product: getProductBySlug(category.slug) as ProductCategory },
  }));
}

type Props = { product: ProductCategory };

const { product } = Astro.props;

const relatedPosts = product.relatedBlogSlugs
  .map((slug) => getBlogBySlug(slug))
  .filter((post): post is BlogPost => Boolean(post));
const categoryProducts = getProductItemsByCategory(product.slug);
const canonicalPath = product.canonicalSlug
  ? `/products/${product.canonicalSlug}`
  : `/products/${product.slug}`;

const pageH1 = categoryPageH1(product.title);
---

<BaseLayout title={`${pageH1} | CoolerFit`} description={product.description} canonicalPath={canonicalPath}>
  <div class="pt-24 md:pt-32 pb-20">
    <div class="container">
      <Breadcrumb
        class="mb-6"
        items={[{ label: "Home", href: "/" }, { label: "Products", href: "/products" }, { label: product.title }]}
      />

      <div class="mb-10">
        <span class="section-hd-label">Product Category</span>
        <h1 class="text-3xl md:text-5xl font-display font-bold text-foreground mb-4">{pageH1}</h1>
        <p class="text-lg text-muted-foreground max-w-3xl">{product.description}</p>
      </div>

      <div class="mb-12">
        <h2 class="text-2xl font-display font-semibold text-foreground mb-6">Key Features</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            product.features.map((feature) => (
              <div class="flex items-start gap-3 p-4 bg-secondary rounded-xl border border-border/20 hover:border-primary/15 transition-all duration-200">
                <Icon name="CheckCircle" size={18} class="text-primary shrink-0 mt-0.5" />
                <span class="text-sm text-foreground">{feature}</span>
              </div>
            ))
          }
        </div>
      </div>

      {
        categoryProducts.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-display font-semibold text-foreground mb-6">Products in This Category</h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {categoryProducts.map((item) => (
                <Card class="group border border-border/60 shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-300 overflow-hidden">
                  <CardContent class="p-0">
                    <div class="aspect-[4/3] overflow-hidden bg-gradient-to-b from-secondary/50 to-secondary flex items-center justify-center p-4 md:p-5 rounded-t-xl">
                      <ProductImageCard
                        src={item.image}
                        alt={item.imageAlt ?? item.name}
                        class="w-full h-full transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                      />
                    </div>
                    <div class="p-5">
                      <h3 class="font-display font-semibold text-foreground mb-1">{item.name}</h3>
                      <p class="text-sm text-muted-foreground mb-3 line-clamp-2">{item.summary}</p>
                      <div class="flex flex-wrap gap-1 mb-4">
                        {item.categorySlugs
                          .filter((s) => s !== product.slug)
                          .slice(0, 2)
                          .map((s) => (
                            <span class="text-[10px] bg-secondary text-muted-foreground px-2 py-0.5 rounded-full">
                              {s.replace(/-/g, " ")}
                            </span>
                          ))}
                      </div>
                      <a
                        href={`/product/${item.slug}`}
                        class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
                      >
                        View Details <Icon name="ArrowRight" size={14} />
                      </a>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        )
      }

      <div class="mb-12 p-8 md:p-10 bg-secondary rounded-2xl text-center border border-border/20">
        <h2 class="text-2xl font-display font-semibold text-foreground mb-3">Get a Quote for {product.title}</h2>
        <p class="text-muted-foreground mb-6 max-w-lg mx-auto">Share your unit dimensions, photos, or drawings — we'll quote a made-to-measure cover for {product.title} within 24 hours.</p>
        <QuoteLink
          quote={{
            categorySlug: product.slug,
            categoryName: product.title,
            ref: `/products/${product.slug}`,
          }}
          class={cn(buttonVariants({ size: "lg" }), "shadow-md hover:shadow-lg")}
        >
          Request a Quote
        </QuoteLink>
      </div>

      <CategorySeoContent product={product} />

      {
        product.internalLinks.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-display font-semibold text-foreground mb-4">Related</h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {product.internalLinks.map((link) => (
                <InternalLinkCard label={link.label} path={link.path} />
              ))}
            </div>
          </div>
        )
      }

      {
        relatedPosts.length > 0 && (
          <div>
            <h2 class="text-2xl font-display font-semibold text-foreground mb-4">Learn More</h2>
            <div class="grid gap-4 sm:grid-cols-2">
              {relatedPosts.map((post) => (
                <Card class="border border-border/60 shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
                  <CardContent class="p-5">
                    <a href={`/blog/${post.slug}`} class="group">
                      <h3 class="font-display font-semibold text-foreground group-hover:text-primary transition-colors mb-1">
                        {post.title}
                      </h3>
                      <p class="text-sm text-muted-foreground">{post.excerpt}</p>
                    </a>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import Icon from "@/components/Icon.astro";
import { getPillarPosts, getClusterPosts } from "@/data/blog";

const pillars = getPillarPosts();
---

<BaseLayout
  title="Cooler Cover Guides & Resources | CoolerFit Blog"
  description="Expert guides on evaporative cooler covers — materials, sizing, installation, maintenance, and customization."
  canonicalPath="/blog"
>
  <div class="pt-24 md:pt-32 pb-20">
    <div class="container">
      <Breadcrumb class="mb-6" items={[{ label: "Home", href: "/" }, { label: "Blog" }]} />

      <div class="text-center mb-12">
        <span class="section-hd-label">Resources</span>
        <h1 class="text-3xl md:text-5xl font-display font-bold text-foreground mb-4">Cooler Cover Knowledge Base</h1>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          Expert guides on evaporative cooler covers — materials, sizing, installation, maintenance, and customization.
        </p>
      </div>

      <div class="space-y-8">
        {
          pillars.map((pillar) => {
            const clusters = getClusterPosts(pillar.slug);
            return (
              <Card class="border border-border/60 shadow-xs hover:shadow-md transition-all duration-300 overflow-hidden">
                <div class="p-6 bg-secondary border-b border-border">
                  <a href={`/blog/${pillar.slug}`} class="group">
                    <div class="flex items-center gap-2 mb-2">
                      <Icon name="BookOpen" size={16} class="text-primary" />
                      <span class="text-xs font-semibold text-primary uppercase tracking-wider">Pillar Guide</span>
                    </div>
                    <h2 class="text-xl md:text-2xl font-display font-bold text-foreground group-hover:text-primary transition-colors">
                      {pillar.title}
                    </h2>
                    <p class="text-sm text-muted-foreground mt-1">{pillar.excerpt}</p>
                  </a>
                </div>
                <CardContent class="p-6">
                  <div class="grid gap-2 sm:grid-cols-2">
                    {clusters.map((cluster) => (
                      <a
                        href={`/blog/${cluster.slug}`}
                        class="group flex items-center justify-between gap-2 p-3 rounded-lg hover:bg-secondary transition-colors"
                      >
                        <span class="text-sm text-foreground group-hover:text-primary transition-colors">
                          {cluster.title}
                        </span>
                        <Icon
                          name="ArrowRight"
                          size={14}
                          class="text-muted-foreground group-hover:text-primary shrink-0 transition-colors"
                        />
                      </a>
                    ))}
                  </div>
                </CardContent>
              </Card>
            );
          })
        }
      </div>
    </div>
  </div>
</BaseLayout>
